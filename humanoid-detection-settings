// enable: 0 - off 1 - on
// show_human: whether to display the human shape box 0 - no 1 - yes
// sensitivity: sensitivity 0-100
// duration: alarm persistence duration
// output: alarm linkage/trigger
// 	ALARM_OUT_SNAPSHOT 	= (0x1 << 1),  // snapshot to SD card
// 	ALARM_OUT_EMAIL 	= (0x1 << 2),  // alarm email
// 	ALARM_OUT_BUZZING 	= (0x1 << 3),  // relay (or Buzzer/Siren)
// 	ALARM_OUT_VOICE 	= (0x1 << 4),  // voice alarm (or Sound alarm)
//	ALARM_OUT_WHITELAMP = (0x1 << 5),  // white light linkage
//	ALARM_OUT_FTP 		= (0x1 << 7),  // send alarm image via FTP
//	ALARM_OUT_RECORD 	= (0x1 << 9),  // save alarm video to SD card
// 	ALARM_OUT_FTP_RECORD = (0x1 << 10), // send alarm video to FTP server
// light_work_mode: light linkage work mode 0: day working 1: night working 2: all-day working
// voice_work_mode: voice linkage work mode 0: day working 1: night working 2: all-day working
// alarm_out_work_mode: alarm output linkage work mode 0: day working 1: night working 2: all-day working
// voice_index: currently invalid
// rect_num: alarm region boxes, supports up to 4 boxes (rect_num=0 means full-screen alarm)
// rect: alarm box position
// 	x: x-coordinate of the top-left corner
// 	y: y-coordinate of the top-left corner
// 	w: width
// 	h: height
// color:
// 	alpha: Transparency 0xFF is completely opaque
// 	red: Red
// 	green: Green
// 	blue: Blue
// schedule: alarm time periods (Sunday-Saturday). Supports setting up to 3 armed/monitoring periods per day.

