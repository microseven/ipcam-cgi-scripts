// enable: Switch 0 - off 1 - on
// email_server：server address
// email_server_port：server port
// email_crypto: server encryption method
// email_username: email login username
// email_passwd: email SMTP service password
// email_sender: sender email address
// email_sender_name：sender name
// email_recipient0: email recipient 1
// email_recipient1: email recipient 2
// email_recipient2: email recipient 3
// email_recipient3: email recipient 4
// email_recipient4: email recipient 5
// email_subject: email subject 
// email_content: email content
// attach_pic: whether to send attachment 1 - on

// email-settings
// 1. (get) GET
// 2. (set) POST
// 3. (test) GET
// 4. (default) GET

// email-settings
// 1. (get) GET
// ipcam-cgi-scripts:
/cgi-bin/web.cgi?mod=alarm_out&cmd=get

