// name: username
// pwd: password. 8-16 digits, lowercase letters, uppercase letters, and special characters (!"#$%<br>&()*+,-./:;<=>?@[\]^_`{|}~) with a combination of three or more types.
// type: currently unsupported
// power: currently unsupported

// onvif-user-management
// 1. (query) GET
// 2. (add) POST
// 3. (modify) POST
// 4. (delete) POST

// 1. (query) GET
// ipcam-cgi-scripts:
/cgi-bin/web.cgi?mod=onvif_account&cmd=list

// return data example: 
[{"name":"admin","pwd":"password","type":0,"power":0}]

// 2. (add) POST
// ipcam-cgi-scripts:
/cgi-bin/web.cgi

// POST data example: 
{"mod":"onvif_account","cmd":"add","param":{"name":"admin2","pwd":"password"}}

// return data example: 
{"status":"ok","data":""}

// 3. (modify) POST
// only the password for a teammate's username can be modified.
// ipcam-cgi-scripts:
/cgi-bin/web.cgi

// POST data example: 
{"mod":"onvif_account","cmd":"modify","param":{"name":"admin","pwd":"password2"}}

// return data example: 
{"status":"ok","data":""}

// 4. (delete) POST
// ipcam-cgi-scripts:
/cgi-bin/web.cgi

// POST data example: 
{"mod":"onvif_account","cmd":"delete","param":{"name":"admin2"}}

// return data example: 
{"status":"ok","data":""}
