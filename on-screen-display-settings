{"enable":1,"datetime":{"enable":1,"pos":2,"date_fmt":0,"time_fmt":1,"show_week":0},"text":[{"enable":0,"pos":0,"data":"MICROSEVEN"},{"enable":0,"pos":0,"data":""},{"enable":0,"pos":0,"data":""},{"enable":0,"pos":0,"data":""},{"enable":0,"pos":0,"data":""}]}

